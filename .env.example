# Copy to .env.local for development.

# ---- Anthropic ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_MODEL_BALANCED=claude-sonnet-4-6
ANTHROPIC_MODEL_HIGHEST=claude-opus-4-7

# ---- Postgres (the app's only datastore) ----
# Local: postgres://postgres:postgres@localhost:5432/smartcogen
# RDS:   postgres://USER:PASSWORD@your-instance.rds.amazonaws.com:5432/smartcogen
DATABASE_URL=postgres://postgres:postgres@localhost:5432/smartcogen
# TLS is required by default (RDS). Set to "disable" for a local Postgres.
DATABASE_SSL=disable
#DATABASE_POOL_MAX=10

# ---- Auth ----
# HMAC key for session JWTs. Generate with: openssl rand -base64 48
# Must be at least 32 characters. Rotating it signs everyone out.
AUTH_JWT_SECRET=
# Session lifetime before re-login is required. Default 168 (7 days).
#AUTH_SESSION_TTL_HOURS=168

# ---- Tavily — web search probe for the plag check ----
# Optional; if missing, the plag check only uses the local corpus.
TAVILY_API_KEY=

# ---- Plag tuning ----
# fuzzball token_set_ratio above this threshold (0–1) flags a match.
# 0.85 catches exact + minor edits; raise toward 1.0 to be stricter.
PLAG_FUZZ_THRESHOLD=0.85

# ---- LLM provider ----
# "anthropic" (default) or "inhouse". The in-house driver lives in
# lib/ai/providers/inhouse.ts and is not implemented yet.
#LLM_PROVIDER=anthropic
#LLM_BASE_URL=
#LLM_API_KEY=
# Model ids per quality tier. Override when pointing at the in-house model;
# these take precedence over the ANTHROPIC_MODEL_* names above.
#LLM_MODEL_FAST=
#LLM_MODEL_BALANCED=
#LLM_MODEL_HIGHEST=

# ---- Embeddings provider (semantic dedup) ----
# "voyage" (default) or "inhouse". Configured separately from the LLM.
#EMBEDDINGS_PROVIDER=voyage
#EMBEDDINGS_BASE_URL=
#EMBEDDINGS_API_KEY=
#EMBEDDINGS_MODEL=
