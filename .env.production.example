# Copy to /var/www/smartcogen/.env.production on the server and fill in.
# Next.js loads .env.production automatically with `next start`.

# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_MODEL_BALANCED=claude-sonnet-4-6
ANTHROPIC_MODEL_HIGHEST=claude-opus-4-7

# ---- Postgres (RDS) ----
DATABASE_URL=postgres://smartcogen:PASSWORD@your-rds-host.rds.amazonaws.com:5432/smartcogen
# RDS needs TLS (default). Set to "disable" only for a local/unencrypted Postgres.
#DATABASE_SSL=disable
#DATABASE_POOL_MAX=10

# ---- Auth ----
# Generate with: openssl rand -base64 48
# Keep it out of source control, and identical across every app instance behind
# the load balancer — otherwise sessions issued by one will not validate on another.
AUTH_JWT_SECRET=
#AUTH_SESSION_TTL_HOURS=168

# ---- Embeddings & plagiarism ----
VOYAGE_API_KEY=pa-...
VOYAGE_EMBEDDING_MODEL=voyage-3.5
TAVILY_API_KEY=tvly-...
#PLAG_FUZZ_THRESHOLD=0.85

# ---- LLM provider ----
# "anthropic" (default) or "inhouse". The in-house driver lives in
# lib/ai/providers/inhouse.ts and is not implemented yet.
#LLM_PROVIDER=anthropic
#LLM_BASE_URL=
#LLM_API_KEY=
# Model ids per quality tier. Override when pointing at the in-house model;
# these take precedence over the ANTHROPIC_MODEL_* names above.
#LLM_MODEL_FAST=
#LLM_MODEL_BALANCED=
#LLM_MODEL_HIGHEST=

# ---- Embeddings provider (semantic dedup) ----
# "voyage" (default) or "inhouse". Configured separately from the LLM.
#EMBEDDINGS_PROVIDER=voyage
#EMBEDDINGS_BASE_URL=
#EMBEDDINGS_API_KEY=
#EMBEDDINGS_MODEL=
