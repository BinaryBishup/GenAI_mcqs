# Copy to /var/www/assessly/.env.production on the server and fill in.
# Next.js loads .env.production automatically with `next start`.

# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_MODEL_BALANCED=claude-sonnet-5
ANTHROPIC_MODEL_HIGHEST=claude-opus-4-7

# ---- Data plane ----
# When DATABASE_URL is set the app talks DIRECTLY to this Postgres (RDS)
# for all data. Unset it to fall back to Supabase-hosted data (instant rollback).
DATABASE_URL=postgres://assessly:PASSWORD@your-rds-host.rds.amazonaws.com:5432/assessly
# RDS needs TLS (default). Set to "disable" only for a local/unencrypted Postgres.
#DATABASE_SSL=disable
#DATABASE_POOL_MAX=10

# ---- Auth plane (stays on Supabase until Phase 3) ----
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# ---- Embeddings & plagiarism ----
VOYAGE_API_KEY=pa-...
VOYAGE_EMBEDDING_MODEL=voyage-3.5
TAVILY_API_KEY=tvly-...
